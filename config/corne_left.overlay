/*
 * Configuration Devicetree pour la moitié gauche (Central)
 * - Trackpad Azoteq local gauche sur I2C (adresse 0x74)
 * - Câblage : RDY sur TX0 (&pro_micro 1 / P0.06), RST sur RX1 (&pro_micro 0 / P0.08)
 * - Résistances de tirage I2C internes activées (bias-pull-up)
 * - Inversion des axes X et Y (flip-x, flip-y)
 * - Réception des événements du trackpad droit via zmk,input-split
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <dt-bindings/input/input-event-codes.h>

/* Activation des résistances pull-up internes sur le bus I2C (SDA=P0.17, SCL=P0.20) */
&i2c0_default {
    group1 {
        bias-pull-up;
    };
};

&i2c0_sleep {
    group1 {
        bias-pull-up;
    };
};

&pro_micro_i2c {
    status = "okay";

    trackpad_left: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        status = "okay";

        /* Câblage corrigé : RST sur RX1 (&pro_micro 0) et RDY sur TX0 (&pro_micro 1) */
        reset-gpios = <&pro_micro 0 GPIO_ACTIVE_LOW>;
        rdy-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        one-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        two-finger-tap;

        scroll;
        natural-scroll-y;
        natural-scroll-x;

        bottom-beta = <5>;
        stationary-threshold = <5>;

        /* Inversion et permutation des axes pour orientation normale */
        flip-x;
        flip-y;
        switch-xy;
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad_split: trackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackpad_left_listener: trackpad_left_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackpad_left>;
    };

    trackpad_right_listener: trackpad_right_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackpad_split>;
    };
};
